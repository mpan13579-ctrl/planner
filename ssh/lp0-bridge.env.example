# Copy to ssh/lp0-bridge.env and fill in. That file is gitignored.
#   cp ssh/lp0-bridge.env.example ssh/lp0-bridge.env

# --- Connection ----------------------------------------------------------
# Hostname or IP of lp0, as reachable from the machine running the bridge.
LP0_HOST=lp0.example.internal
LP0_USER=your-username
LP0_PORT=22

# Private key used to authenticate. Generate with:
#   ssh-keygen -t ed25519 -f ~/.ssh/id_lp0 -C "lp0-bridge"
LP0_IDENTITY="$HOME/.ssh/id_lp0"

# Optional bastion/jump host if lp0 is not directly reachable.
# Format: [user@]host[:port]. Leave empty for a direct connection.
LP0_JUMP=

# --- Forwards ------------------------------------------------------------
# Space-separated. Each entry becomes an ssh -L argument.
# Format: [bind_address:]local_port:remote_host:remote_port
# Binding to 127.0.0.1 keeps the forwarded port off your LAN — drop the
# prefix only if you intend other machines to reach it.
# The first entry carries lp0's vLLM server (OpenAI-compatible API; `vllm
# serve` listens on 8000 by default). The second lands on lp0's own sshd,
# giving `ssh -p 8022 localhost`.
LP0_LOCAL_FORWARDS="127.0.0.1:8000:localhost:8000 127.0.0.1:8022:localhost:22"

# Space-separated ssh -R arguments, exposing local services on lp0.
# Format: [bind_address:]remote_port:local_host:local_port
LP0_REMOTE_FORWARDS=""

# Local SOCKS5 proxy port (ssh -D). Empty disables it.
LP0_SOCKS_PORT=

# --- Behavior ------------------------------------------------------------
# Seconds between keepalives, and how many may go unanswered before the
# connection is torn down and retried.
LP0_ALIVE_INTERVAL=30
LP0_ALIVE_COUNT_MAX=3

# Backoff bounds for the plain-ssh retry loop (seconds). Ignored when
# autossh is installed, since autossh handles its own retries.
LP0_RETRY_MIN=2
LP0_RETRY_MAX=60
